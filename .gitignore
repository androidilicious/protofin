# --- secrets ---
.env
.env.*
!.env.example

# --- python ---
__pycache__/
*.pyc
.venv/
venv/

# --- runtime state and logs at the repo root (regenerated by every run); site/data/runs IS tracked ---
/state/
/runs/

# --- downloaded data caches (re-fetched automatically); keep the derived FOMC index ---
data/*
!data/news/
data/news/*
!data/news/fomc_index.csv

# --- large regenerable research outputs; keep summaries and the paid masked-replay results ---
research/out/backtest_curves.csv
research/out/backtest_weights.csv
research/out/backtest_report.html
research/out/masked_skill.csv
research/out/fomc_validation.csv

# --- diagram build artifacts (docs/protofin-pipeline.html and the spec are kept) ---
docs/*.visual-check.*
docs/protofin-pipeline.meta.json

# --- agent/IDE tool folders: these are machine-specific symlinks to .agents/skills ---
.claude/
.cursor/
.commandcode/
.agent/
# vendored archify skill: keep the renderer, drop its examples and tests
.agents/skills/archify/examples/
.agents/skills/archify/test/
.agents/skills/archify-review/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
