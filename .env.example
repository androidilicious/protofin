# Copy to .env and fill in. .env is git-ignored and never leaves this machine.
OPENAI_API_KEY=sk-...

# Optional overrides
# LLM_MODEL=gpt-4o          # model for the local server and for the saved committee runs
# PROTOTYPE_MODE=1          # 1 = no cache / state / trade policy (default); 0 = stability controls on
# HEADLINES_MODE=display    # off | display | decide  (headlines never enter the decision unless 'decide')
# FOMC_MODEL=tim9510019/FOMC-RoBERTa   # ungated re-train of gtfintechlab/FOMC-RoBERTa

# Stochastic view evaluation (experimental; docs/EMPIRICAL_UNCERTAINTY.md)
# STOCHASTIC_VIEWS=0        # 1 = run the committee N times on the same input at VIEW_TEMPERATURE
# VIEW_TEMPERATURE=0.2
# VIEW_N_RUNS=5             # >= 2; costs N x 3 model calls
# VIEW_SEED=                # optional base seed; run r uses seed + r (best effort only)
# CONFIDENCE_MODE=combined  # reported | empirical | combined
