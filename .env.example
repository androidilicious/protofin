# Copy to .env and fill in. .env is git-ignored and never leaves this machine.
OPENAI_API_KEY=sk-...

# Optional overrides
# LLM_MODEL=gpt-4o          # model for the local server and for the saved committee runs
# PROTOTYPE_MODE=1          # 1 = no cache / state / trade policy (default); 0 = stability controls on
# HEADLINES_MODE=display    # off | display | decide  (headlines never enter the decision unless 'decide')
# FOMC_MODEL=tim9510019/FOMC-RoBERTa   # ungated re-train of gtfintechlab/FOMC-RoBERTa

# --- Backtest branch: Causal RAG real-model runs (native_backtest) ---
# Set these as environment secrets of the machine or cloud environment, never in git or chat.
# HF_TOKEN=                       # fine-grained Hugging Face token: manage Inference Endpoints + read the gated meta-llama repo
# AP3_ALLOW_PAID_INFERENCE=0      # set to 1 only for a run covered by an approval record in native_backtest/config/approvals/
# The endpoint URL, model revision and request timeout are set by the endpoint controller; do not set them by hand.
# Not used without separate approval: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (Bedrock), DEEPINFRA_API_KEY.
