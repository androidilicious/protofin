{
 "_comment": "Bloomberg data request for the AP3 mediator FF_FUTURES_6M (fed funds path, six months ahead). Licensed data: the export is stored under native_backtest/data/_licensed/bloomberg/ (git-ignored); only hashes and summary checks are committed. Request document: native_backtest/docs/BLOOMBERG_FED_FUNDS_FUTURES_REQUEST_2026-10-28.md",
 "version": "v1.2",
 "created": "2026-10-28",
 "mediator": {
  "name": "FF_FUTURES_6M",
  "definition": "For each day d: implied average effective fed funds rate for calendar month month(d)+6 = 100 - daily settlement price of the CME 30-Day Federal Funds futures contract for that month. One-day changes are taken on the same contract.",
  "availability_rule": "same day, 17:00 ET (after the CME daily settlement)"
 },
 "date_range": [
  "2012-01-03",
  "2026-08-31"
 ],
 "frequency": "daily, trading days only (non-trading days omitted, no fill)",
 "history_request": {
  "function": "BDH",
  "fields": [
   "PX_SETTLE"
  ],
  "required_fields": [
   "PX_SETTLE"
  ],
  "options": {
   "Days": "Trading days only (non-trading days omitted)",
   "Fill": "None (blank)",
   "Currency": "none (contract native)",
   "Adjustment": "none"
  },
  "securities": "every contract in contracts[] (expired form first; live form if the expired form does not resolve) plus reference_series[]",
  "not_needed": "PX_LAST, VOLUME and OPEN_INT are not used by the importer and are no longer requested"
 },
 "static_request": {
  "function": "BDP",
  "fields": [
   "FUT_DLV_DT_FIRST",
   "FUT_DLV_DT_LAST",
   "LAST_TRADEABLE_DT"
  ],
  "required_fields": [
   "FUT_DLV_DT_FIRST",
   "FUT_DLV_DT_LAST",
   "LAST_TRADEABLE_DT"
  ],
  "use": "Delivery dates identify each contract's month (the ticker text is not trusted); LAST_TRADEABLE_DT dates the final-settlement check"
 },
 "reference_series": [
  {
   "ticker": "FEDL01 Index",
   "field": "PX_LAST",
   "use": "effective fed funds rate; checks each expired contract's final settlement (100 - monthly average)",
   "status": "recommended (enables the final-settlement check; the import passes without it but records the check as skipped)"
  }
 ],
 "fallback_generic": {
  "tickers": [
   "FF1 Comdty",
   "FF2 Comdty",
   "FF3 Comdty",
   "FF4 Comdty",
   "FF5 Comdty",
   "FF6 Comdty",
   "FF7 Comdty",
   "FF8 Comdty",
   "FF9 Comdty"
  ],
  "fields": [
   "PX_SETTLE"
  ],
  "note": "Only if individual contracts are unavailable. Generic tickers roll at expiry, so the importer then needs the roll calendar (LAST_TRADEABLE_DT of each underlying) to avoid roll jumps."
 },
 "export_format": {
  "history_file": "ff_futures_history.csv",
  "history_columns": [
   "date",
   "ticker",
   "field",
   "value"
  ],
  "static_file": "ff_futures_static.csv",
  "static_columns": [
   "ticker",
   "field",
   "value"
  ],
  "encoding": "UTF-8, comma-separated, header row, ISO dates (YYYY-MM-DD), values with full precision, one row per date/ticker/field, missing values omitted",
  "alternative": "A wide Excel BDH sheet saved as CSV (first column Date, then one column per '<ticker>|<field>') is also accepted by the importer."
 },
